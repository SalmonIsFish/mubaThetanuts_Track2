# Base mainnet RPC. A public endpoint works for reads; use a private RPC
# (Alchemy/Infura/QuickNode) for the actual broadcast to avoid public-endpoint
# rate limits or drops on a live trade.
THETANUTS_RPC_URL=https://mainnet.base.org

# Micro-trade wallet only. Fund with just enough USDC/WETH for one small
# trade plus a little ETH for gas. Never reuse a wallet that holds
# significant funds for a hackathon demo script.
PRIVATE_KEY=0x...

# Must match gate-chain/server.py's bind address/port.
GATE_SERVICE_URL=http://127.0.0.1:8787

# Hard ceiling enforced client-side in executeMicroTrade.ts, independent of
# the gate chain's own MAX_NOTIONAL_USD_PER_TRADE -- belt and suspenders
# before anything reaches a signer.
MAX_NOTIONAL_USD_HARD_CAP=25
