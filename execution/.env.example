# Base mainnet RPC. Get a free key first -- the public endpoint
# (https://mainnet.base.org) works for a one-off read, but starts throttling
# the moment an agent polls in a loop, and a throttled RPC mid-fill looks
# exactly like a bug in your code. Alchemy (alchemy.com -> create app -> Base
# Mainnet) or Infura (infura.io -> create key -> Base) both have a free tier
# that's more than enough for a hackathon.
THETANUTS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Micro-trade wallet only -- a FRESH, DISPOSABLE wallet, never one holding
# anything you'd miss. `npm i -g @thetanuts-finance/cli` then
# `thetanuts wallet create` generates one with locked-down file permissions.
# Fund it with 1-3 USDC and a few cents of ETH for gas, nothing more.
# Named THETANUTS_PRIVATE_KEY (not a generic PRIVATE_KEY) to match the SDK's
# and CLI's own convention. Never commit this -- check `git log -p` on this
# file before you submit, same as the official checklist says.
THETANUTS_PRIVATE_KEY=0x...

# Must match gate-chain/server.py's bind address/port.
GATE_SERVICE_URL=http://127.0.0.1:8787

# Hard ceiling enforced client-side in executeMicroTrade.ts, independent of
# the gate chain's own MAX_NOTIONAL_USD_PER_TRADE -- belt and suspenders
# before anything reaches a signer. "1-3 USDC covers you" per the workshop
# deck; a 1 USDC fill scores identically to a 100 USDC one, so there's no
# reason to raise this for the demo.
MAX_NOTIONAL_USD_HARD_CAP=3
