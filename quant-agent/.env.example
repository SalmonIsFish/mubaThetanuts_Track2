# Thetanuts (Base 8453) — uses execution API at 8790 + gate-chain 8787, no Alpaca keys needed
THETANUTS_RPC_URL=https://mainnet.base.org
GATE_SERVICE_URL=http://127.0.0.1:8787
EXECUTION_API_URL=http://127.0.0.1:8790
# On VPS: EXECUTION_API_URL=https://amanahtrader.uk/thetanuts/api
# THE knob — confidence >= this executes autonomously, below asks y/n
AUTO_TRADE_THRESHOLD=0.80
# Risk caps
MAX_ORDERS_PER_DAY=5
MAX_POSITION_PCT=40
MAX_SECTOR_EXPOSURE_PCT=15.0
# Shariah universe (Thetanuts crypto)
SHARIAH_UNIVERSE_PATH=E:/Github2/mubaThetanuts_Track2/data/crypto-underlying-universe.json
